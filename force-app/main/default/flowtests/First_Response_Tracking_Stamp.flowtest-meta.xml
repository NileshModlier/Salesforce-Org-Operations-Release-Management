<?xml version="1.0" encoding="UTF-8"?>
<FlowTest xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Moving a case from New to Working with an empty First Response At takes the stamp path.</description>
    <flowApiName>First_Response_Tracking</flowApiName>
    <label>Stamp when status leaves New</label>
    <testPoints>
        <elementApiName>Start</elementApiName>
        <parameters>
            <leftValueReference>$Record</leftValueReference>
            <type>InputTriggeringRecordInitial</type>
            <value>
                <sobjectValue>{"attributes":{"type":"Case"},"Subject":"Password reset","Status":"New","Priority":"Medium","Origin":"Phone"}</sobjectValue>
            </value>
        </parameters>
        <parameters>
            <leftValueReference>$Record</leftValueReference>
            <type>InputTriggeringRecordUpdated</type>
            <value>
                <sobjectValue>{"attributes":{"type":"Case"},"Subject":"Password reset","Status":"Working","Priority":"Medium","Origin":"Phone"}</sobjectValue>
            </value>
        </parameters>
    </testPoints>
    <testPoints>
        <assertions>
            <conditions>
                <leftValueReference>Outcome</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Stamped</stringValue>
                </rightValue>
            </conditions>
            <errorMessage>First response was not stamped when status left New.</errorMessage>
        </assertions>
        <elementApiName>Finish</elementApiName>
    </testPoints>
    <testType>WithAssertion</testType>
</FlowTest>
