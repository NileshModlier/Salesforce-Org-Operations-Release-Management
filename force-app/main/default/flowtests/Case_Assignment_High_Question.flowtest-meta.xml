<?xml version="1.0" encoding="UTF-8"?>
<FlowTest xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>A high-priority Question stays with the L1 Support Queue.</description>
    <flowApiName>Case_Assignment</flowApiName>
    <label>High question routes to L1</label>
    <testPoints>
        <elementApiName>Start</elementApiName>
        <parameters>
            <leftValueReference>$Record</leftValueReference>
            <type>InputTriggeringRecordInitial</type>
            <value>
                <sobjectValue>{"attributes":{"type":"Case"},"Subject":"How do I reset a password","Status":"New","Priority":"High","Origin":"Email","Type":"Question"}</sobjectValue>
            </value>
        </parameters>
    </testPoints>
    <testPoints>
        <assertions>
            <conditions>
                <leftValueReference>Route</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>L1</stringValue>
                </rightValue>
            </conditions>
            <errorMessage>A high-priority Question did not stay on the L1 route.</errorMessage>
        </assertions>
        <elementApiName>Finish</elementApiName>
    </testPoints>
    <testType>WithAssertion</testType>
</FlowTest>
