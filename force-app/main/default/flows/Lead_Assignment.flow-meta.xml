    <decisions>
        <name>Route_By_Product_Interest</name>
        <label>Route by product interest</label>
        <locationX>350</locationX>
        <locationY>100</locationY>
        <defaultConnector>
            <targetReference>Use_Default_Owner</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Undecided or blank</defaultConnectorLabel>
        <rules>
            <name>Core_Product</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Product_Interest__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core Product</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Use_Core_Owner</targetReference>
            </connector>
            <label>Core Product</label>
        </rules>
        <rules>
            <name>Add_on_Service</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Product_Interest__c</leftValueReference>
