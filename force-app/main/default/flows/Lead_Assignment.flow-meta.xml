                <rightValue>
                    <stringValue>Renewal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Use_Renewal_Owner</targetReference>
            </connector>
            <label>Renewal</label>
        </rules>
    </decisions>
    <decisions>
        <name>Owner_Found</name>
        <label>Owner found</label>
        <locationX>350</locationX>
        <locationY>500</locationY>
        <defaultConnector>
            <targetReference>Set_Owner_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Placeholder user is missing</defaultConnectorLabel>
        <rules>
            <name>User_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Owner.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Lead_Owner</targetReference>
            </connector>
            <label>User found</label>
        </rules>
    </decisions>
    <description>Assigns a lead to a named owner placeholder chosen from Product Interest. Draft until a scratch org can resolve the placeholder users. A missing user leaves the creator as owner.</description>
    <environments>Default</environments>
    <interviewLabel>Lead Assignment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead Assignment</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Owner</name>
        <label>Get owner</label>
        <locationX>350</locationX>
        <locationY>380</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Owner_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Username</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>OwnerUsername</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Assign_Lead_Owner</name>
        <label>Assign lead owner</label>
        <locationX>200</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Set_Assigned</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_Owner.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>350</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Route_By_Product_Interest</targetReference>
        </connector>
        <filterFormula>ISNEW() || ISCHANGED({!$Record.Product_Interest__c})</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
