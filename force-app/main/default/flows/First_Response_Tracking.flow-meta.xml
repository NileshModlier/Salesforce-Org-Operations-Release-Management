<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <assignments>
        <name>Set_Stamped</name>
        <label>Set stamped</label>
        <locationX>150</locationX>
        <locationY>250</locationY>
        <assignmentItems>
            <assignToReference>Outcome</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Stamped</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Stamp_First_Response</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Skipped</name>
        <label>Set skipped</label>
        <locationX>400</locationX>
        <locationY>250</locationY>
        <assignmentItems>
            <assignToReference>Outcome</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Skipped</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Capture_Fault</name>
        <label>Capture Fault</label>
        <locationX>650</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>Outcome</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Fault</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>FaultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Moved_Off_New</name>
        <label>Moved off New with an empty stamp</label>
        <locationX>275</locationX>
        <locationY>100</locationY>
        <defaultConnector>
            <targetReference>Set_Skipped</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Do not stamp</defaultConnectorLabel>
        <rules>
            <name>Stamp</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.First_Response_At__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Stamped</targetReference>
            </connector>
            <label>Stamp</label>
        </rules>
    </decisions>
    <description>Before-save flow. When a case status leaves New and First Response At is empty, stamp the current date and time. A later status change does not overwrite it.</description>
    <environments>Default</environments>
    <interviewLabel>First Response Tracking {!$Flow.CurrentDateTime}</interviewLabel>
    <label>First Response Tracking</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Stamp_First_Response</name>
        <label>Stamp first response</label>
        <locationX>150</locationX>
        <locationY>380</locationY>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>First_Response_At__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>275</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Moved_Off_New</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.Status})</filterFormula>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>Outcome</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>FaultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
