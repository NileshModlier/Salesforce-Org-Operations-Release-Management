    <decisions>
        <name>Check_Age</name>
        <label>Older than one day</label>
        <locationX>300</locationX>
        <locationY>150</locationY>
        <defaultConnector>
            <targetReference>Set_Not_Due</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not yet due</defaultConnectorLabel>
        <rules>
            <name>Past_Threshold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PastThreshold</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_L2_Queue</targetReference>
            </connector>
            <label>Past threshold</label>
        </rules>
    </decisions>
    <decisions>
        <name>Queue_Found</name>
        <label>Queue found</label>
        <locationX>300</locationX>
        <locationY>420</locationY>
        <defaultConnector>
            <targetReference>Set_Queue_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Queue is missing</defaultConnectorLabel>
        <rules>
            <name>Queue_Is_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_L2_Queue.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Ops_Admin</targetReference>
            </connector>
            <label>Queue is present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Admin_Found</name>
        <label>Ops Admin found</label>
        <locationX>300</locationX>
        <locationY>640</locationY>
        <defaultConnector>
            <targetReference>Set_No_Ops_Admin</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Ops Admin</defaultConnectorLabel>
        <rules>
            <name>Admin_Is_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Ops_Admin.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remember_Admin</targetReference>
            </connector>
            <label>Admin is present</label>
        </rules>
    </decisions>
    <description>Scheduled path one day after CreatedDate. A high-priority case that is still open is set to Escalated, moved to the L2 Escalation Queue, and the Ops Admin persona is notified. The immediate path escalates only when the case is already older than one day. Draft until an org can host the queue, the persona user, and the notification type.</description>
    <environments>Default</environments>
    <formulas>
        <name>PastThreshold</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!$Record.CreatedDate})), {!$Record.CreatedDate} &lt;= (NOW() - 1))</expression>
    </formulas>
    <formulas>
        <name>ReasonToStore</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Escalation_Reason__c}), "Automatically escalated. High priority case exceeded the one-day threshold.", {!$Record.Escalation_Reason__c})</expression>
    </formulas>
    <formulas>
        <name>EscalatedByToStore</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Escalated_By__c}), {!Get_Ops_Admin.Id}, {!$Record.Escalated_By__c})</expression>
    </formulas>
    <formulas>
        <name>NotificationBody</name>
        <dataType>String</dataType>
        <expression>"High priority case " &amp; {!$Record.CaseNumber} &amp; " was escalated after one day."</expression>
    </formulas>
    <interviewLabel>Escalation {!$Flow.CurrentDateTime}</interviewLabel>
