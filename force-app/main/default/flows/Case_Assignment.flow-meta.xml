<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <assignments>
        <name>Route_L2</name>
        <label>Route to L2</label>
        <locationX>150</locationX>
        <locationY>250</locationY>
        <assignmentItems>
            <assignToReference>Route</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>L2</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>QueueDeveloperName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>L2_Escalation</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Queue</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Route_L1</name>
        <label>Route to L1</label>
        <locationX>450</locationX>
        <locationY>250</locationY>
        <assignmentItems>
            <assignToReference>Route</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>L1</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>QueueDeveloperName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>L1_Support</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Queue</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Assigned</name>
        <label>Set assigned</label>
        <locationX>200</locationX>
        <locationY>700</locationY>
        <assignmentItems>
            <assignToReference>Outcome</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Assigned</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Queue_Not_Found</name>
        <label>Set queue not found</label>
        <locationX>500</locationX>
        <locationY>550</locationY>
        <assignmentItems>
            <assignToReference>Outcome</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>QueueNotFound</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>FaultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>The L1 Support Queue or L2 Escalation Queue was not found. The case keeps the creator as owner.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Capture_Fault</name>
        <label>Capture Fault</label>
        <locationX>750</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>Outcome</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Fault</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>FaultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Route_By_Priority_And_Type</name>
        <label>Route by priority and type</label>
        <locationX>300</locationX>
        <locationY>100</locationY>
        <defaultConnector>
            <targetReference>Route_L1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>L1</defaultConnectorLabel>
        <rules>
            <name>High_Problem</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Problem</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Route_L2</targetReference>
            </connector>
            <label>High problem</label>
        </rules>
        <rules>
            <name>High_Feature_Request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Feature Request</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Route_L2</targetReference>
            </connector>
            <label>High feature request</label>
        </rules>
        <rules>
            <name>High_Without_Type</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Route_L2</targetReference>
            </connector>
            <label>High without type</label>
        </rules>
    </decisions>
    <decisions>
        <name>Queue_Found</name>
        <label>Queue found</label>
        <locationX>300</locationX>
        <locationY>480</locationY>
        <defaultConnector>
            <targetReference>Set_Queue_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Queue is missing</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Queue.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Case_Owner</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <description>Routes a new case to the L1 Support Queue or the L2 Escalation Queue from Priority and Type. Draft until the queues exist in an org. A missing queue leaves the creator as owner.</description>
    <environments>Default</environments>
    <interviewLabel>Case Assignment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Assignment</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Queue</name>
        <label>Get queue</label>
        <locationX>300</locationX>
        <locationY>370</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Queue_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>QueueDeveloperName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Assign_Case_Owner</name>
        <label>Assign case owner</label>
        <locationX>150</locationX>
        <locationY>590</locationY>
        <connector>
            <targetReference>Set_Assigned</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_Queue.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>300</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Route_By_Priority_And_Type</targetReference>
        </connector>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>Route</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>QueueDeveloperName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>Outcome</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>FaultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
