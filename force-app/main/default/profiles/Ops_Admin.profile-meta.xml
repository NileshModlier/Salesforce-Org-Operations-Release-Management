<?xml version="1.0" encoding="UTF-8"?>
<Profile xmlns="http://soap.sforce.com/2006/04/metadata">
    <custom>true</custom>
    <description>Minimum-access shell for Ops Admin. Layouts for every project object. Setup rights are on the Ops Admin permission set, not this profile.</description>
    <userLicense>Salesforce</userLicense>
    <applicationVisibilities>
        <application>standard__AllTab</application>
        <default>true</default>
        <visible>true</visible>
    </applicationVisibilities>
    <applicationVisibilities>
        <application>standard__LightningSales</application>
        <default>false</default>
        <visible>true</visible>
    </applicationVisibilities>
    <applicationVisibilities>
        <application>standard__LightningService</application>
        <default>false</default>
        <visible>true</visible>
    </applicationVisibilities>
    <layoutAssignments>
        <layout>Lead-Ops Admin</layout>
    </layoutAssignments>
    <layoutAssignments>
        <layout>Opportunity-Ops Admin</layout>
    </layoutAssignments>
    <layoutAssignments>
        <layout>Case-Ops Admin</layout>
    </layoutAssignments>
    <layoutAssignments>
        <layout>User-Ops Admin</layout>
    </layoutAssignments>
</Profile>
